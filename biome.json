{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": { "includes": ["src/**", "public/**", "scripts/**", "modules/**", "test/**", "extras/**"] },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useTemplate": "off", "noDescendingSpecificity": "off", "useExponentiationOperator": "off" },
      "suspicious": { "noAssignInExpressions": "off" },
      "complexity": { "noCommaOperator": "off", "noImportantStyles": "off" },
      "a11y": { "useSemanticElements": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["public/app.js"],
      "linter": { "rules": { "suspicious": { "noRedundantUseStrict": "off" } } }
    }
  ]
}
